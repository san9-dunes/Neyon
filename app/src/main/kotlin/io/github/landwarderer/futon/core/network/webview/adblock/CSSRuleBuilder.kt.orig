package io.github.landwarderer.futon.core.network.webview.adblock

import androidx.collection.ArraySet

class CSSRuleBuilder {

	private val selectors = ArraySet<String>()

	fun add(selector: String) {
		selectors.add(selector)
	}

	fun build() = buildString {
		if (selectors.isEmpty()) {
			return@buildString
		}

		append("<style> ")
		val iterator = selectors.iterator()
		while (iterator.hasNext()) {
			append(iterator.next())
			if (iterator.hasNext()) {
				append(", ")
			}
		}
		append(" { display: none !important; }</style>")
	}

	fun isEmpty() = selectors.isEmpty()
}
